RewriteEngine On
RewriteBase /projectsphere/

# Enforce HTTPS on production (non-localhost) domains
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Prevent access to hidden files, git, backups, and configs
<FilesMatch "(\.(git|env|sql|bak|config|lock|log|sh)|composer\.json|package\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# If accessing root directory directly, rewrite to frontend
RewriteRule ^$ frontend/ [L]

# Route assets to frontend/assets
RewriteRule ^assets/(.*)$ frontend/assets/$1 [L]

# Route admin requests to frontend/admin
RewriteRule ^admin/(.*)$ frontend/admin/$1 [L]

# Route student requests to frontend/student
RewriteRule ^student/(.*)$ frontend/student/$1 [L]

# Route uploads to backend/uploads
RewriteRule ^uploads/(.*)$ backend/uploads/$1 [L]

# Route api to backend/api
RewriteRule ^api/(.*)$ backend/api/$1 [L]

# Route install.php to backend/install.php
RewriteRule ^install\.php$ backend/install.php [L]

# Route common standalone PHP pages to frontend
RewriteRule ^(browse|login|logout|register|search|terms|privacy|project-details)\.php$ frontend/$1.php [L]

# SEO files
RewriteRule ^robots\.txt$ frontend/robots.php [L]
RewriteRule ^sitemap\.xml$ frontend/sitemap.php [L]

# 404 handler
ErrorDocument 404 /projectsphere/frontend/404.php